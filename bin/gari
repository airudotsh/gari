#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Gari launcher — the engine is gari.py in GARI_HOME (default: this repo)."""
import os
import sys

_here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
os.environ.setdefault("GARI_HOME", _here)
sys.path.insert(0, os.environ["GARI_HOME"])
import gari  # noqa: E402

sys.exit(gari.main())
